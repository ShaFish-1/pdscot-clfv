% =====================================================================
%  ScotogenicDirac.mdl - arXiv:2605.05312, three quasi-Dirac pairs
%  Short names (<=3 chars) avoid the CalcHEP editor P-column overflow.
%  Naming: ~N1/~N2 = pair 1 (light/heavy), ~N3/~N4 = pair 2,
%          ~N5/~N6 = pair 3;  ~ep/~em, ~eR, ~eI = inert scalars.
%  DM = ~N1.  SM from SMmodern via `use`.
% =====================================================================

keys gauge_fixing=Feynman.

do_if gauge_fixing==Feynman.
model 'ScotogenicDirac (Feyn. gauge)'/1.
do_else_if gauge_fixing==unitary.
model 'ScotogenicDirac (un. gauge)'/1.
do_else.
write('Error: the key "gauge_fixing" should be either "Feynman" or "unitary".').
quit.
end_if.

option ReduceGamma5=0.
let g5=gamma5.

use SMmodern.

% ---------------------------------------------------------------------
% External parameters (Sec.2/3; Eq.9,30,32)
% ---------------------------------------------------------------------
parameter lam2I = 0.1        : 'Inert-doublet self-coupling lambda2',
         mu22  = 250000     : 'mu2^2 (inert doublet mass^2)',
         MD    = 200        : 'Dirac mass M (Eq.9)',
         muL   = 0.0005     : 'Majorana mass mu (Eq.9)',
         mR    = 500        : 'm(etaR)',
         mI    = 500.01     : 'm(etaI)',
         mEp   = 540        : 'm(eta+)',
         ye    = 0.1        : 'y_e (Sec.3 benchmark: = y1)',
         ym    = 0          : 'y_mu (Eq.9 single-pair model only)',
         yt    = 0          : 'y_tau (Eq.9 single-pair model only)',
         epe   = 0.001      : 'eps_e',
         epm   = 0.001      : 'eps_mu',
         ept   = 0.001      : 'eps_tau',
         y2    = 0.4        : 'y_mu, pair 2 (Eq.30)',
         y3    = 0.4        : 'y_tau, pair 3 (Eq.30)',
         epe2  = 0          : 'eps_e2  (Eq.32)',
         epm2  = 0          : 'eps_mu2 (Eq.32)',
         ept2  = 0          : 'eps_tau2(Eq.32)',
         epe3  = 0          : 'eps_e3  (Eq.32)',
         epm3  = 0          : 'eps_mu3 (Eq.32)',
         ept3  = 0          : 'eps_tau3(Eq.32)',
         MN1   = 199.9995   : 'N1 mass (pair 1, light)',
         MN1p  = 200.0005   : 'N2 mass (pair 1, heavy)',
         MN2   = 499.9995   : 'N3 mass (pair 2, light)',
         MN2p  = 500.0005   : 'N4 mass (pair 2, heavy)',
         MN3   = 999.9995   : 'N5 mass (pair 3, light)',
         MN3p  = 1000.0005  : 'N6 mass (pair 3, heavy)'.

% Majorana masses are external parameters: numeric in vars1.mdl
% (micrOMEGAs DD reads them) and overridable via input.par.

parameter La5 = (mR**2-mI**2)/v**2    : 'lambda5 (Eq.6)',
         La4 = (mR**2+mI**2-2*mEp**2)/v**2 : 'lambda4',
         La3 = 2*(mEp**2-mu22)/v**2  : 'lambda3'.

% ---------------------------------------------------------------------
% Z2-odd Majorana singlets (Eq.8/9)
% ---------------------------------------------------------------------
spinor '~N1'/'~N1':('N1', mass MN1, width wN1 = auto),
       '~N2'/'~N2':('N2', mass MN1p, width wN1p = auto),
       '~N3'/'~N3':('N3', mass MN2, width wN2 = auto),
       '~N4'/'~N4':('N4', mass MN2p, width wN2p = auto),
       '~N5'/'~N5':('N5', mass MN3, width wN3 = auto),
       '~N6'/'~N6':('N6', mass MN3p, width wN3p = auto).

% ---------------------------------------------------------------------
% Z2-odd inert scalars:  eta = (etap, (etaR + i etaI)/Sqrt2)
% ---------------------------------------------------------------------
scalar '~ep'/'~em':('eta+', mass mEp, width wEp = auto),
       '~eR'/'~eR':('etaR', mass mR, width wR = auto),
       '~eI'/'~eI':('etaI', mass mI, width wI = auto).

let ph2 = { '~ep',  ('~eR'+i*'~eI')/Sqrt2 },
    PH2 = { '~em', ('~eR'-i*'~eI')/Sqrt2 }.

% Majorana mass terms (Eq.9)
lterm Mm*anti(N)*N/2 + AddHermConj where
    Mm = MN1,  N = '~N1';
    Mm = MN1p, N = '~N2';
    Mm = MN2,  N = '~N3';
    Mm = MN2p, N = '~N4';
    Mm = MN3,  N = '~N5';
    Mm = MN3p, N = '~N6'.

% Majorana kinetic terms
lterm anti(psi)*gamma*(1+g5)/2*(i*deriv)*psi where
    psi='~N1'; psi='~N2';
    psi='~N3'; psi='~N4';
    psi='~N5'; psi='~N6'.

% ---------------------------------------------------------------------
% Yukawa (Eq.9 rotated, Eq.30-32):
%   Y_light = (y+eps)/Sqrt2,  Y_heavy = i*(y-eps)/Sqrt2
% ---------------------------------------------------------------------
lterm -Y*(anti(n)*(1+g5)/2*N*('~eR'+i*'~eI')/Sqrt2
          - anti(e)*(1+g5)/2*N*'~em') + AddHermConj
    where
        Y=(ye+epe)/Sqrt2,  n=n1, e=e1, N='~N1';
        Y=epm/Sqrt2,       n=n2, e=e2, N='~N1';
        Y=ept/Sqrt2,       n=n3, e=e3, N='~N1';
        Y=i*(ye-epe)/Sqrt2, n=n1, e=e1, N='~N2';
        Y=-i*epm/Sqrt2,     n=n2, e=e2, N='~N2';
        Y=-i*ept/Sqrt2,     n=n3, e=e3, N='~N2'.

% Pair 2 (Eq.30)
lterm -Y*(anti(n)*(1+g5)/2*N*('~eR'+i*'~eI')/Sqrt2
          - anti(e)*(1+g5)/2*N*'~em') + AddHermConj
    where
        Y=epe2/Sqrt2,       n=n1, e=e1, N='~N3';
        Y=(epm2+y2)/Sqrt2,  n=n2, e=e2, N='~N3';
        Y=ept2/Sqrt2,       n=n3, e=e3, N='~N3';
        Y=-i*epe2/Sqrt2,      n=n1, e=e1, N='~N4';
        Y=i*(epm2-y2)/Sqrt2,  n=n2, e=e2, N='~N4';
        Y=-i*ept2/Sqrt2,      n=n3, e=e3, N='~N4'.

% Pair 3 (Eq.30)
lterm -Y*(anti(n)*(1+g5)/2*N*('~eR'+i*'~eI')/Sqrt2
          - anti(e)*(1+g5)/2*N*'~em') + AddHermConj
    where
        Y=epe3/Sqrt2,       n=n1, e=e1, N='~N5';
        Y=epm3/Sqrt2,       n=n2, e=e2, N='~N5';
        Y=(ept3+y3)/Sqrt2,  n=n3, e=e3, N='~N5';
        Y=-i*epe3/Sqrt2,      n=n1, e=e1, N='~N6';
        Y=-i*epm3/Sqrt2,      n=n2, e=e2, N='~N6';
        Y=i*(ept3-y3)/Sqrt2,  n=n3, e=e3, N='~N6'.

% Inert scalar potential (Eq.3)
lterm -mu22*PH2*ph2
      -lam2I*(PH2*ph2)**2
      -La3*pp*PP*ph2*PH2
      -La4*PP*ph2*PH2*pp
      -La5/2*(PP*ph2*PP*ph2 + PH2*pp*PH2*pp).

% Kinetic term of the inert doublet
let Dph2^mu^a = (deriv^mu+i*g1/2*B1^mu)*ph2^a +
    i*g/2*taupm^a^b^c*WW^mu^c*ph2^b.

let DPH2^mu^a = (deriv^mu-i*g1/2*B1^mu)*PH2^a
    -i*g/2*taupm^a^b^c*{'W-'^mu,W3^mu,'W+'^mu}^c*PH2^b.

lterm DPH2*Dph2.

% ---------------------------------------------------------------------
% Output options
% ---------------------------------------------------------------------
prtcprop pdg:(d=1, u=2, s=3, c=4, b=5, t=6, G=21, A=22, Z=23, 'W+'=24, H=25,
             e1=11, n1=12, e2=13, n2=14, e3=15, n3=16,
             '~ep'=9000005, '~eR'=9000006, '~eI'=9000007,
             '~N1'=9000012, '~N2'=9000014,
             '~N3'=9000016, '~N4'=9000018,
             '~N5'=9000020, '~N6'=9000022).

SetAngle(1-SW**2=CW**2).
SetEM(A,EE).
CheckHerm.
