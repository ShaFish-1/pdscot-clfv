% =====================================================================
%  SMmodern.mdl - modern Standard Model base (LanHEP)
%
%  SM 部分, extracted from the verified ScotogenicDiracFull.mdl.
%  micrOMEGAs-compatible naming (n1/V1,e1, n2/V2,e2, n3/V3,e3).
%
%  Loaded by the extension file ScotogenicDiracExt.mdl through:
%        use SMmodern.mdl.
%
%  Modern values: MH=125, Mtop=172, EW inputs aEWM1/Gf/aS.
% =====================================================================

% ---------------------------------------------------------------------
% External parameters (SM)
% ---------------------------------------------------------------------
parameter aEWM1 = 127.9     : 'Inverse of the EW coupling constant at the Z pole',
         Gf    = 1.16637e-5 : 'Fermi constant',
         aS    = 0.1184     : 'Strong coupling constant at the Z pole',
         PI    = 3.141592653589793 : 'pi constant',
         cabi  = 0.227736   : 'Cabibbo angle'.

parameter aEW = 1/aEWM1 : 'Electroweak coupling constant'.

% ---------------------------------------------------------------------
% Gauge bosons
% ---------------------------------------------------------------------
do_if gauge_fixing==Feynman.
vector A/A:(photon, gauge),
       Z/Z:('Z boson', mass MZ = 91.1876, width wZ = 2.4952, gauge),
       G/G:(gluon, color c8, gauge),
       'W+'/'W-':('W boson',
           mass MW = sqrt(MZ**2/2 + sqrt(MZ**4/4 - PI*aEW/Gf*MZ**2/Sqrt2)),
           width wW = 2.085, gauge).
do_else.
vector A/A:(photon, gauge),
       Z/Z:('Z boson', mass MZ = 91.1876, width wZ = 2.4952),
       G/G:(gluon, color c8, gauge),
       'W+'/'W-':('W boson',
           mass MW = sqrt(MZ**2/2 + sqrt(MZ**4/4 - PI*aEW/Gf*MZ**2/Sqrt2)),
           width wW = 2.085).
end_if.

% ---------------------------------------------------------------------
% Fermions
% ---------------------------------------------------------------------
spinor n1/V1:('e-neutrino',left), e1:(electron, mass Me = 5.11e-4),
       n2/V2:('mu-neutrino',left), e2:(muon, mass Mm = 0.10566),
       n3/V3:('tau-neutrino',left), e3:('tau-lepton', mass Mta = 1.777).

spinor u:('u-quark',color c3, mass Mup = 2.55e-3),
       d:('d-quark',color c3, mass Mdo = 5.04e-3),
       c:('c-quark',color c3, mass Mc = 1.27),
       s:('s-quark',color c3, mass Ms = 0.101),
       t:('t-quark',color c3, mass Mtop = 172, width wtop = 1.50833649),
       b:('b-quark',color c3, mass Mb = 4.7).

scalar H/H:(Higgs, mass MH = 125, width wH = 0.00407).

% ---------------------------------------------------------------------
% Internal (derived) parameters - gauge sector
% ---------------------------------------------------------------------
parameter SW2 = 1 - (MW/MZ)**2       : 'Squared sine of the Weinberg angle',
         EE  = sqrt(4*PI*aEW)        : 'Electric coupling constant',
         SW  = sqrt(SW2)             : 'Sine of the Weinberg angle',
         CW  = sqrt(1-SW2)           : 'Cosine of the Weinberg angle',
         GG  = sqrt(4*PI*aS)         : 'Strong coupling constant',
         v   = 2*MW*SW/EE            : 'Higgs vacuum expectation value'.

% ---------------------------------------------------------------------
% CKM matrix - only Cabibbo mixing
% ---------------------------------------------------------------------
parameter Vud = cos(cabi)  : 'CKM element',
         Vus = sin(cabi)   : 'CKM element',
         Vub = 0           : 'CKM element',
         Vcd = -sin(cabi)  : 'CKM element',
         Vcs = cos(cabi)   : 'CKM element',
         Vcb = 0           : 'CKM element',
         Vtd = 0           : 'CKM element',
         Vts = 0           : 'CKM element',
         Vtb = 1           : 'CKM element'.

OrthMatrix( { {Vud,Vus,Vub}, {Vcd,Vcs,Vcb}, {Vtd,Vts,Vtb} } ).

% ---------------------------------------------------------------------
% Field definitions
% ---------------------------------------------------------------------
let l1={n1,e1}, L1={V1,E1}.
let l2={n2,e2}, L2={V2,E2}.
let l3={n3,e3}, L3={V3,E3}.

let q1={u,d}, Q1={U,D}, q1a={u,Vud*d+Vus*s+Vub*b}, Q1a={U,Vud*D+Vus*S+Vub*B}.
let q2={c,s}, Q2={C,S}, q2a={c,Vcd*d+Vcs*s+Vcb*b}, Q2a={C,Vcd*D+Vcs*S+Vcb*B}.
let q3={t,b}, Q3={T,B}, q3a={t,Vtd*d+Vts*s+Vtb*b}, Q3a={T,Vtd*D+Vts*S+Vtb*B}.

% Gauge fields in the physical basis
let B1= -SW*Z+CW*A, W3=CW*Z+SW*A, W1=('W+'+'W-')/Sqrt2,
    W2 = i*('W+'-'W-')/Sqrt2.

do_if gauge_fixing==Feynman.
let gh1 = ('W+.c'+'W-.c')/Sqrt2, gh2= i*('W+.c'-'W-.c')/Sqrt2,
    gh3= CW*'Z.c'+SW*'A.c', gh={gh1,gh2,gh3}.
let Gh1 = ('W+.C'+'W-.C')/Sqrt2, Gh2=i*('W+.C'-'W-.C')/Sqrt2,
    Gh3= CW*'Z.C'+SW*'A.C', Gh={Gh1,Gh2,Gh3}.
end_if.

let WW1 = {W1,  W2 , W3}, WW = {'W+',W3,'W-'}.

let g=EE/SW, g1=EE/CW.

% Higgs doublet Phi
do_if gauge_fixing==Feynman.
let pp = { -i*'W+.f',  (vev(2*MW/EE*SW)+H+i*'Z.f')/Sqrt2 },
    PP = {  i*'W-.f',  (vev(2*MW/EE*SW)+H-i*'Z.f')/Sqrt2 }.
do_else.
let pp = { 0,  (vev(2*MW/EE*SW)+H)/Sqrt2 },
    PP = { 0,  (vev(2*MW/EE*SW)+H)/Sqrt2 }.
end_if.

% ---------------------------------------------------------------------
% Gauge-boson self-interactions
% ---------------------------------------------------------------------
lterm -F**2/4 where F=deriv^mu*B1^nu-deriv^nu*B1^mu.

lterm -F**2/4 where
    F=deriv^mu*G^nu^a-deriv^nu*G^mu^a+i*GG*f_SU3^a^b^c*G^mu^b*G^nu^c.

lterm -F**2/4 where
    F=deriv^mu*WW1^nu^a-deriv^nu*WW1^mu^a - g*eps^a^b^c*WW1^mu^b*WW1^nu^c.

% ---------------------------------------------------------------------
% Fermion kinetic and gauge interactions
% ---------------------------------------------------------------------
lterm anti(psi)*gamma*(1-g5)/2*(i*deriv-g*taupm*WW/2-Y*g1*B1)*psi
    where
        psi=l1,  Y=-1/2;
        psi=l2,  Y=-1/2;
        psi=l3,  Y=-1/2;
        psi=q1a, Y= 1/6;
        psi=q2a, Y= 1/6;
        psi=q3a, Y= 1/6.

lterm anti(psi)*gamma*(1+g5)/2*(i*deriv - Y*g1*B1)*psi
    where
        psi=e1,Y= -1;
        psi=e2,Y= -1;
        psi=e3,Y= -1;
        psi=u, Y=  2/3;
        psi=c, Y=  2/3;
        psi=t, Y=  2/3;
        psi=d, Y= -1/3;
        psi=s, Y= -1/3;
        psi=b, Y= -1/3.

lterm GG*anti(psi)*lambda*gamma*G*psi where
    psi=q1; psi=q2; psi=q3.

% ---------------------------------------------------------------------
% SM Yukawa couplings
% ---------------------------------------------------------------------
lterm -M/MW/Sqrt2*g*(anti(pl)*(1+g5)/2*pr*pp + anti(pr)*(1-g5)/2*pl*PP)
    where
        M=Vud*Mdo, pl=q1a, pr=d;
        M=Vus*Ms,  pl=q1a, pr=s;
        M=Vub*Mb,  pl=q1a, pr=b;
        M=Vcd*Mdo, pl=q2a, pr=d;
        M=Vcs*Ms,  pl=q2a, pr=s;
        M=Vcb*Mb,  pl=q2a, pr=b;
        M=Vtd*Mdo, pl=q3a, pr=d;
        M=Vts*Ms,  pl=q3a, pr=s;
        M=Vtb*Mb,  pl=q3a, pr=b.

lterm -M/MW/Sqrt2*g*(anti(pl)*(1+g5)/2*i*tau2*pr*PP
        + anti(pr)*(1-g5)/2*i*pl*tau2*pp)
    where
        M=Mup,  pl=q1a, pr=u;
        M=Mc,   pl=q2a, pr=c;
        M=Mtop, pl=q3a, pr=t.

lterm -M/MW/Sqrt2*g*(anti(pl)*(1+g5)/2*pr*pp + anti(pr)*(1-g5)/2*pl*PP)
    where
        M=Me,  pl=l1, pr=e1;
        M=Mm,  pl=l2, pr=e2;
        M=Mta, pl=l3, pr=e3.

% Higgs potential
lterm -2*lambda*(pp*PP-v**2/2)**2 where lambda=(g*MH/MW)**2/16.

% Kinetic term of the SM Higgs doublet
let Dpp^mu^a = (deriv^mu+i*g1/2*B1^mu)*pp^a +
    i*g/2*taupm^a^b^c*WW^mu^c*pp^b.

let DPP^mu^a = (deriv^mu-i*g1/2*B1^mu)*PP^a
    -i*g/2*taupm^a^b^c*{'W-'^mu,W3^mu,'W+'^mu}^c*PP^b.

lterm DPP*Dpp.

% ---------------------------------------------------------------------
% Ghost and gauge-fixing terms
% ---------------------------------------------------------------------
lterm -i*GG*f_SU3*ccghost(G)*G^mu*deriv^mu*ghost(G).
lterm -1/2*(deriv*G)**2.

do_if gauge_fixing==Feynman.
lterm g*eps*deriv*Gh*gh*WW1.

lterm -1/2*(deriv*A)**2.

lterm -1/2*(2*(deriv*'W+'+MW*'W+.f')*(deriv*'W-'+MW*'W-.f') +
        (deriv*Z+MW/CW*'Z.f')**2).

lterm -MW*EE/2/SW*((H+i*'Z.f')*('W-.C'*'W+.c' + 'W+.C'*'W-.c')
        +H*'Z.C'*'Z.c'/CW**2-2*i*'Z.f'*'W+.C'*'W-.c').

lterm i*EE*MW/2/CW/SW*(
    'W+.f'*('W-.C'*'Z.c'*(1-2*SW**2)+'W-.c'*'Z.C'
            +2*CW*SW*'W-.C'*'A.c') -
    'W-.f'*('W+.C'*'Z.c'*(1-2*SW**2)+'W+.c'*'Z.C'
            +2*CW*SW*'W+.C'*'A.c')).
end_if.
